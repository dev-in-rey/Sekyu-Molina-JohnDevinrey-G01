# Sekyu — Environment Configuration Example
# Copy this file to .env and fill in your PostgreSQL database credentials.
# Never commit your .env file to version control.

DJANGO_SECRET_KEY=replace-with-a-secure-random-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sekyu_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
