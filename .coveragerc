[run]
branch = True
plugins =
    django_coverage_plugin
source =
    accounts
    dashboard
    households
    passes
    sekyu
    templates
omit =
    */migrations/*
    */.venv/*
    */__pycache__/*
    */tests.py

[report]
show_missing = True
skip_covered = False
fail_under = 95
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
